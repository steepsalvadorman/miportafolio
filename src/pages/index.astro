---
import Layout from '../layouts/Layout.astro';
import AeroWindow from '../components/AeroWindow.astro';
import VistaClock from '../components/VistaClock.astro';
import SkillsPanel from '../components/SkillsPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { personalInfo, summary, experience, achievements, education, skills, projects } from '../data/portfolio';
import { certificates } from '../data/certificates';

const email = `mailto:${personalInfo.email}`;
const github = `https://${personalInfo.github}`;
const linkedin = `https://${personalInfo.linkedin}`;
const phoneHref = `tel:${personalInfo.phone.replace(/[^+\d]/g, '')}`;

const featuredOrder = ['Industrial Scale Integration', 'Enterprise API Framework', 'CodeCraft Peru'];
const featured = projects
  .filter((project) => project.featured)
  .sort((a, b) => featuredOrder.indexOf(a.title) - featuredOrder.indexOf(b.title));
const moreProjects = projects.filter((project) => !project.featured);

const projectAnchor = (id: number) => `proyecto-${id}`;

const currentJob = experience[0];
const university = education[0];

const credentialTitles = ['Spring Boot 3 y Spring Framework 6', 'Curso completo del lenguaje Rust', 'Docker · Guía práctica para desarrolladores'];
const selectedCredentials = certificates.filter((cert) => credentialTitles.includes(cert.title));

const profileFacts = [
  { label: 'Rol actual', value: 'QA Automation y Programador' },
  { label: 'Empresa', value: currentJob?.company },
  { label: 'Sectores', value: 'Minería, banca y consultoría' },
  { label: 'Stack', value: 'Spring Boot, TypeScript, Playwright, Rust' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personalInfo.name,
  jobTitle: 'Ingeniero de Sistemas',
  email: `mailto:${personalInfo.email}`,
  sameAs: [github, linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: university?.institution },
  knowsAbout: ['Spring Boot', 'TypeScript', 'Playwright', 'Automatización de pruebas', 'Integración de sistemas'],
};
---

<Layout title="Steep Salvador | Ingeniería de software, backend y QA" current="inicio">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />

  <AeroWindow caption="Steep Salvador" labelledBy="hero-titulo" open>
    <div class="grid items-start gap-6 lg:grid-cols-12">
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="text-sm font-semibold text-atrium">Ingeniero de Sistemas</p>
        <h1 id="hero-titulo" class="max-w-[680px] text-4xl text-ink sm:text-5xl">
          Desarrollo software e integro sistemas<br class="hidden sm:inline" />
          para entornos críticos.
        </h1>
        <p class="max-w-[680px] text-lg text-ink-muted">{summary}</p>
        <div class="flex flex-wrap items-center gap-4">
          <a href={email} class="btn btn-dune">Contactar por correo</a>
          <a href="#proyectos" class="btn btn-glass">Ver proyectos</a>
        </div>
      </div>

      <aside class="optic lg:col-span-5" aria-label="Ficha">
        <VistaClock />
        <dl class="optic-facts">
          {
            profileFacts.map((fact) => (
              <div class="optic-fact">
                <span class="optic-lamp" aria-hidden="true"></span>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </AeroWindow>

  <AeroWindow id="proyectos" caption="Proyectos" as="h2" headingId="proyectos-titulo">
    <ul class="grid gap-6 lg:grid-cols-3">
      {
        featured.map((project) => (
          <li class="min-w-0">
            <ProjectCard project={project} anchor={projectAnchor(project.id)} />
          </li>
        ))
      }
    </ul>
    <h3 class="text-xl font-semibold text-ink">Otros proyectos</h3>
    <ul class="-mt-3 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        moreProjects.map((project) => (
          <li class="min-w-0">
            <ProjectCard project={project} anchor={projectAnchor(project.id)} />
          </li>
        ))
      }
    </ul>
  </AeroWindow>

  <AeroWindow id="experiencia" caption="Experiencia" as="h2" headingId="experiencia-titulo">
    <h3 class="text-xl font-semibold text-ink">Logros</h3>
    <ul class="-mt-3 flex flex-col divide-y divide-line">
      {
        achievements.map((achievement) => (
          <li class="flex flex-col gap-1 py-4 first:pt-0 last:pb-0">
            <h4 class="text-base font-semibold text-ink">{achievement.title}</h4>
            <p class="text-base text-ink-muted">{achievement.description}</p>
          </li>
        ))
      }
    </ul>
    <ol class="flex flex-col divide-y divide-line">
      {
        experience.map((job) => (
          <li class="grid gap-4 py-4 first:pt-0 last:pb-0 md:grid-cols-12 md:gap-6">
            <div class="flex flex-col gap-1 md:col-span-4">
              <p class="text-sm font-semibold text-atrium">{job.period}</p>
              <h3 class="text-lg font-semibold text-ink">{job.role.replace(/ ([·/])/g, '\u00a0$1')}</h3>
              <p class="text-sm text-ink-muted">{job.company}</p>
            </div>
            <ul class="flex flex-col gap-2 md:col-span-8">
              {job.responsibilities.map((item) => (
                <li class="flex gap-3 text-base text-ink-muted">
                  <span aria-hidden="true" class="mt-2 size-2 shrink-0 bg-magenta"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </AeroWindow>

  <SkillsPanel skills={skills} />

  <AeroWindow id="formacion" caption="Formación" as="h2" headingId="formacion-titulo">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        education.map((edu) => (
          <article class="flex flex-col gap-2 border border-yellow p-4">
            <p class="text-sm font-semibold text-yellow">Universidad</p>
            <h3 class="text-lg font-semibold text-ink">{edu.institution}</h3>
            <p class="text-base text-ink">{edu.degree}</p>
            <p class="text-sm text-ink-muted">{edu.location}</p>
          </article>
        ))
      }
      <div class="lg:col-span-2">
        <h3 class="text-lg font-semibold text-ink">Cursos seleccionados</h3>
        <ul class="mt-2 flex flex-col divide-y divide-line">
          {
            selectedCredentials.map((cert) => (
              <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <span class="text-base text-ink">{cert.title}</span>
                <span class="shrink-0 text-sm text-ink-muted">
                  {cert.issuer}, {cert.date}
                </span>
              </li>
            ))
          }
        </ul>
        <a href="/certificados" class="mt-4 inline-flex min-h-11 items-center text-sm">
          Ver los {certificates.length} cursos y certificados
        </a>
      </div>
    </div>
  </AeroWindow>

  <AeroWindow id="contacto" caption="Contacto" as="h2" headingId="contacto-titulo">
    <div class="flex flex-wrap items-center gap-4">
      <a href={email} class="btn btn-dune">Contactar por correo</a>
      <span class="text-sm text-ink">{personalInfo.email}</span>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4 text-sm">
      <li>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center">
          LinkedIn<span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </li>
      <li>
        <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center">
          GitHub<span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </li>
      <li>
        <a href={phoneHref} class="inline-flex min-h-11 items-center">{personalInfo.phone}</a>
      </li>
    </ul>
  </AeroWindow>
</Layout>
