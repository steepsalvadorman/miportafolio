---
import Layout from '../layouts/Layout.astro';
import AeroWindow from '../components/AeroWindow.astro';
---

<Layout title="Página no encontrada | Steep Salvador" description="La página solicitada no existe." noindex>
  <AeroWindow caption="404" labelledBy="error-titulo">
    <div class="flex max-w-[680px] flex-col gap-6">
      <p class="text-sm font-semibold text-atrium">Error 404</p>
      <h1 id="error-titulo" class="max-w-[680px] text-4xl text-ink md:text-5xl">Esta página no existe.</h1>
      <p class="text-lg text-ink-muted">
        Puede que el enlace haya cambiado. Desde el inicio puedes revisar proyectos, experiencia y contacto.
      </p>
      <a href="/" class="btn btn-dune w-max">Volver al inicio</a>
    </div>
  </AeroWindow>
</Layout>
