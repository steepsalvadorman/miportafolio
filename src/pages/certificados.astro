---
import Layout from '../layouts/Layout.astro';
import AeroWindow from '../components/AeroWindow.astro';
import { certificates, coursesInProgress, inProgressIssuer, inProgressProgram } from '../data/certificates';
---

<Layout
  title="Cursos y certificados | Steep Salvador"
  description="Cursos y certificaciones de Steep Salvador, con emisor, fecha e ID de credencial."
  current="certificados"
>
  <AeroWindow caption="Certificados" labelledBy="certificados-titulo">
    <a href="/" class="inline-flex min-h-11 w-max items-center text-sm">Volver al inicio</a>
    <div class="flex max-w-[680px] flex-col gap-3">
      <p class="text-sm font-semibold text-atrium">{certificates.length} registros</p>
      <h1 id="certificados-titulo" class="max-w-[680px] text-4xl text-ink md:text-5xl">Cursos y certificados</h1>
      <p class="text-lg text-ink-muted">Un curso no es una certificación del fabricante.</p>
    </div>
    <section aria-labelledby="en-curso-titulo" class="flex flex-col gap-3 border border-cyan p-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="en-curso-titulo" class="text-xl text-ink">En curso</h2>
        <p class="font-mono text-xs text-cyan">{inProgressIssuer} · {inProgressProgram}</p>
      </div>
      <ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
        {
          coursesInProgress.map((course) => (
            <li class="flex items-baseline gap-3">
              <span class="shrink-0 font-mono text-xs text-ink-muted">{course.code}</span>
              <span class="text-base text-ink">{course.title}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <ul class="flex flex-col divide-y divide-line">
      {
        certificates.map((cert) => (
          <li class="flex flex-col gap-2 py-4 first:pt-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div class="flex min-w-0 flex-col gap-1">
              <h2 class="text-lg font-semibold text-ink">{cert.title}</h2>
              <p class="text-sm text-ink-muted">{cert.issuer}</p>
              {cert.credentialId && <p class="break-all font-mono text-xs text-ink-muted">ID {cert.credentialId}</p>}
            </div>
            <div class="flex shrink-0 items-center gap-4">
              <p class="text-sm text-ink">
                {cert.date}
                {cert.expires && <span class="text-ink-muted"> · venció {cert.expires}</span>}
              </p>
              {cert.verifyUrl && (
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center text-sm"
                >
                  Verificar<span class="sr-only"> {cert.title} (se abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </AeroWindow>
</Layout>
