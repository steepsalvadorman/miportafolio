---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'inicio' | 'certificados' | 'none';
  noindex?: boolean;
}

const {
  title,
  description = 'Portafolio de Steep Salvador, Ingeniero de Sistemas con experiencia en Spring Boot, TypeScript, automatización de pruebas e integración industrial.',
  current = 'none',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#10111e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Steep Salvador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%2310111E'/><text y='.9em' font-size='70' fill='%23F6D86A' font-family='monospace' font-weight='bold' x='10'>&gt;_</text></svg>"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ok');
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <a
      href="#contenido"
      data-skip-link
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-yellow focus:inline-flex focus:min-h-11 focus:items-center focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-canvas"
    >
      Saltar al contenido
    </a>
    <SiteHeader current={current} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter />

    <script>
      const root = document.documentElement;

      if (root.classList.contains('motion-ok')) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

        const words = Array.from(document.querySelectorAll<HTMLElement>('[data-tagline] .tagline-word'));
        const wordObserver = new IntersectionObserver(
          (entries) => {
            const crossing = entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement)
              .sort((a, b) => words.indexOf(a) - words.indexOf(b));

            crossing.forEach((word, order) => {
              word.style.transitionDelay = `${order * 90}ms`;
              word.classList.add('is-lit');
              wordObserver.unobserve(word);
            });
          },
          { rootMargin: '0px 0px -35% 0px' },
        );
        words.forEach((word) => wordObserver.observe(word));
      }
    </script>
  </body>
</html>
