---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'inicio' | 'certificados' | 'none';
  noindex?: boolean;
}

const {
  title,
  description = 'Portafolio de Steep Salvador. Spring Boot, TypeScript, pruebas automatizadas e integración industrial.',
  current = 'none',
  noindex = false,
} = Astro.props;

const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%2307060d'/><polygon points='32,0 32,14 8,0' fill='%23ff2bd6'/><polygon points='0,32 0,20 16,32' fill='%233dfff2'/><polygon points='14,8 32,18 32,22 18,12' fill='%23f4f227'/></svg>";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#07060d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Saira:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Steep Salvador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/field.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/field.svg" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ok');
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen pt-12 font-sans text-ink antialiased">
    <a
      href="#contenido"
      data-skip-link
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-16 focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center focus:bg-yellow focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-void"
    >
      Saltar al contenido
    </a>
    <SiteHeader current={current} />
    <main id="contenido" tabindex="-1" class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6 outline-none sm:px-6">
      <slot />
    </main>
    <SiteFooter />

    <script>
      const root = document.documentElement;

      const paintClock = () => {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes();
        const seconds = now.getSeconds();
        document.querySelectorAll<HTMLElement>('[data-clock-face]').forEach((face) => {
          const hour = face.querySelector<HTMLElement>('[data-hand="hour"]');
          const minute = face.querySelector<HTMLElement>('[data-hand="minute"]');
          const second = face.querySelector<HTMLElement>('[data-hand="second"]');
          if (hour) hour.style.transform = `rotate(${(hours % 12) * 30 + minutes * 0.5}deg)`;
          if (minute) minute.style.transform = `rotate(${minutes * 6 + seconds * 0.1}deg)`;
          if (second) second.style.transform = `rotate(${seconds * 6}deg)`;
        });
        const time = new Intl.DateTimeFormat('es-PE', { hour: '2-digit', minute: '2-digit' }).format(now);
        const date = new Intl.DateTimeFormat('es-PE', { weekday: 'long', day: 'numeric', month: 'long' }).format(now);
        document.querySelectorAll<HTMLElement>('[data-clock-text]').forEach((node) => {
          node.textContent = time;
        });
        document.querySelectorAll<HTMLElement>('[data-clock-date]').forEach((node) => {
          node.textContent = date;
        });
      };

      paintClock();
      window.setInterval(paintClock, 1000);

      if (root.classList.contains('motion-ok')) {
        const words = Array.from(document.querySelectorAll<HTMLElement>('[data-tagline] .tagline-word'));
        const wordObserver = new IntersectionObserver(
          (entries) => {
            const crossing = entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement)
              .sort((a, b) => words.indexOf(a) - words.indexOf(b));

            crossing.forEach((word, order) => {
              word.style.transitionDelay = `${order * 90}ms`;
              word.classList.add('is-lit');
              wordObserver.unobserve(word);
            });
          },
          { rootMargin: '0px 0px -35% 0px' },
        );
        words.forEach((word) => wordObserver.observe(word));
      }
    </script>
  </body>
</html>
