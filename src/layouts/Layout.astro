---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'inicio' | 'certificados' | 'none';
  noindex?: boolean;
}

const {
  title,
  description = 'Portafolio de Steep Salvador. Spring Boot, TypeScript, pruebas automatizadas e integración industrial.',
  current = 'none',
  noindex = false,
} = Astro.props;

const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%231a1033'/><circle cx='16' cy='17' r='11' fill='%23ff71ce'/><path d='M5 13a11 11 0 0 1 22 0z' fill='%23fffb96'/><path d='M0 20h32M0 24h32M0 28h32' stroke='%231a1033' stroke-width='1.6'/><rect x='1' y='1' width='30' height='30' fill='none' stroke='%2301cdfe' stroke-width='2'/></svg>";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1a1033" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Saira:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Steep Salvador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/field.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/field.svg" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ok');
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen pt-12 font-sans text-ink antialiased">
    <a
      href="#contenido"
      data-skip-link
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-16 focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center focus:bg-yellow focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-void"
    >
      Saltar al contenido
    </a>
    <SiteHeader current={current} />
    <main id="contenido" tabindex="-1" class="mx-auto flex w-full max-w-6xl flex-col gap-24 px-4 pb-24 pt-6 outline-none sm:px-6">
      <slot />
    </main>
    <SiteFooter />
    <div class="horizon" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>

    <script>
      const root = document.documentElement;

      const paintClock = () => {
        const time = new Intl.DateTimeFormat('es-PE', { hour: '2-digit', minute: '2-digit' }).format(new Date());
        document.querySelectorAll<HTMLElement>('[data-clock-text]').forEach((node) => {
          node.textContent = time;
        });
      };

      paintClock();
      window.setInterval(paintClock, 1000);

      if (root.classList.contains('motion-ok')) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((node) => revealObserver.observe(node));

        const words = Array.from(document.querySelectorAll<HTMLElement>('[data-tagline] .tagline-word'));
        const wordObserver = new IntersectionObserver(
          (entries) => {
            const crossing = entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement)
              .sort((a, b) => words.indexOf(a) - words.indexOf(b));

            crossing.forEach((word, order) => {
              word.style.transitionDelay = `${order * 90}ms`;
              word.classList.add('is-lit');
              wordObserver.unobserve(word);
            });
          },
          { rootMargin: '0px 0px -35% 0px' },
        );
        words.forEach((word) => wordObserver.observe(word));
      }
    </script>
  </body>
</html>
