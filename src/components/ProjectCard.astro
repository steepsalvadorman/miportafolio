---
import Icon from './Icon.astro';
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  anchor: string;
  index: number;
}

const { project, anchor, index } = Astro.props;
---

<article class="card">
  <div class="card-inner">
    <div class="flex items-center justify-between gap-4">
      <span class="font-display text-5xl font-bold text-yellow">{String(index).padStart(2, '0')}</span>
      <span class="hud-label">{project.technologies[0]}</span>
    </div>
    <h3 id={anchor} class="text-2xl text-ink">{project.title}</h3>
    <p class="text-base text-ink-muted">{project.description}</p>
    <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.title}`}>
      {project.technologies.map((tech) => <li class="chip">{tech}</li>)}
    </ul>
    <div class="mt-auto flex flex-wrap gap-x-6 pt-2">
      {
        project.githubUrl ? (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="card-link">
            Ver código en GitHub
            <Icon name="arrow-up-right" class="size-4" />
            <span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
          </a>
        ) : (
          <p class="inline-flex min-h-11 items-center font-mono text-xs text-ink-muted">Repositorio no publicado</p>
        )
      }
      {
        project.demoUrl && (
          <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="card-link">
            Abrir la demo
            <Icon name="arrow-up-right" class="size-4" />
            <span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
          </a>
        )
      }
    </div>
  </div>
</article>
