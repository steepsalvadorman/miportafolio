---
import AeroWindow from './AeroWindow.astro';
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  anchor: string;
}

const { project, anchor } = Astro.props;
---

<AeroWindow caption={project.title} as="h3" headingId={anchor} nested>
  <p class="text-base text-ink-muted">{project.description}</p>
  <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.title}`}>
    {
      project.technologies.map((tech) => (
        <li class="border border-line px-2 py-1 text-xs text-ink">{tech}</li>
      ))
    }
  </ul>
  <div class="mt-auto">
    {
      project.githubUrl ? (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-sm">
          Ver código en GitHub
          <span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
        </a>
      ) : (
        <p class="text-sm text-ink-muted">Repositorio no publicado</p>
      )
    }
    {
      project.demoUrl && (
        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-sm mt-2">
          Abrir la demo
          <span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
        </a>
      )
    }
  </div>
</AeroWindow>
