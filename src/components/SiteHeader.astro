---
import { personalInfo } from '../data/portfolio';

interface Props {
  current: 'inicio' | 'certificados' | 'none';
}

const { current } = Astro.props;

const links = [
  { href: '/#proyectos', label: 'Proyectos', active: false },
  { href: '/#experiencia', label: 'Experiencia', active: false },
  { href: '/certificados', label: 'Certificados', active: current === 'certificados' },
  { href: '/#contacto', label: 'Contacto', active: false },
];

const tray = [
  { href: `https://${personalInfo.github}`, label: 'GitHub' },
  { href: `https://${personalInfo.linkedin}`, label: 'LinkedIn' },
  { href: `mailto:${personalInfo.email}`, label: 'Correo' },
];
---

<header class="taskbar">
  <a href="/" aria-current={current === 'inicio' ? 'page' : undefined} class="task-start hidden md:inline-flex">Steep</a>
  <button
    type="button"
    data-menu-button
    aria-expanded="false"
    aria-controls="menu-inicio"
    aria-label="Abrir menú"
    class="task-start js-only md:hidden"
  >
    Menú
  </button>

  <nav aria-label="Principal" class="hidden min-w-0 md:block">
    <ul class="flex items-center gap-1">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined} class="task-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="task-tray">
    <ul class="hidden items-center sm:flex">
      {
        tray.map((link) => (
          <li>
            <a href={link.href} class="task-link" {...(link.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
              {link.label}
              {!link.href.startsWith('mailto:') && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <p data-clock-text class="px-2 text-sm font-semibold tabular-nums text-cyan">--:--</p>
  </div>

  <div
    id="menu-inicio"
    data-menu
    role="dialog"
    aria-modal="true"
    aria-label="Menú inicio"
    hidden
    class="start-menu js-only"
  >
    <div class="border-b border-line px-3 py-4">
      <p class="font-display text-2xl font-bold text-yellow">Steep Salvador</p>
      <p class="text-sm text-ink-muted">Ingeniero de Sistemas</p>
    </div>
    <ul class="flex flex-col gap-1 p-2">
      <li class="menu-item">
        <a href="/" data-menu-link aria-current={current === 'inicio' ? 'page' : undefined}>Inicio</a>
      </li>
      {
        links.map((link, index) => (
          <li class="menu-item" style={`transition-delay: ${100 + index * 50}ms`}>
            <a href={link.href} data-menu-link aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      {
        tray.map((link, index) => (
          <li class="menu-item sm:hidden" style={`transition-delay: ${300 + index * 50}ms`}>
            <a
              href={link.href}
              data-menu-link
              {...(link.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
            >
              {link.label}
              {!link.href.startsWith('mailto:') && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<ul class="no-js-only fixed top-12 left-0 right-0 z-30 flex flex-wrap gap-1 border-b border-line bg-void px-2 md:hidden">
  {
    links.map((link) => (
      <li>
        <a href={link.href} class="task-link" aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (button && menu) {
    const menuLinks = Array.from(menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]'));
    const outside = () => Array.from(document.querySelectorAll<HTMLElement>('main, footer, [data-skip-link]'));
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';

    const open = () => {
      menu.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Cerrar menú');
      document.body.style.overflow = 'hidden';
      outside().forEach((el) => {
        el.inert = true;
      });
      requestAnimationFrame(() => {
        requestAnimationFrame(() => menu.classList.add('is-open'));
      });
      menuLinks[0]?.focus();
    };

    const close = (returnFocus = true) => {
      menu.classList.remove('is-open');
      menu.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Abrir menú');
      document.body.style.overflow = '';
      outside().forEach((el) => {
        el.inert = false;
      });
      if (returnFocus) button.focus();
    };

    button.addEventListener('click', () => (isOpen() ? close() : open()));
    menuLinks.forEach((link) => link.addEventListener('click', () => close(false)));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }

      if (event.key === 'Tab') {
        const focusables = [button, ...menuLinks];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) close(false);
    });
  }
</script>
