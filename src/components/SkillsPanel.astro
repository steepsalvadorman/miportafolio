---
import type { SkillCategory } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;

const techSkills = skills.filter((group) => group.category !== 'Idiomas');
const languageGroup = skills.find((group) => group.category === 'Idiomas');

const languages =
  languageGroup?.skills.map((entry) => {
    const match = entry.match(/^(.+?)\s*\((.+)\)$/);
    return {
      name: match?.[1]?.trim() ?? entry,
      level: match?.[2]?.trim() ?? '',
    };
  }) ?? [];
---

<section id="tecnologias" aria-labelledby="tecnologias-titulo" class="flex flex-col gap-12">
  <SectionHeading
    id="tecnologias-titulo"
    index="04"
    label="Tecnologías"
    title="Herramientas con las que trabajo"
    intro="Del backend y las pruebas a la nube, las bases de datos y el hardware industrial."
  />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      techSkills.map((group, index) => (
        <div class="panel panel-hover flex flex-col gap-4 p-6" data-reveal style={`--reveal-delay: ${(index % 4) * 100}ms`}>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl text-cyan">{group.category}</h3>
            <span class="font-mono text-xs text-ink-muted">{String(group.skills.length).padStart(2, '0')}</span>
          </div>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="chip">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="panel panel-accent flex flex-col gap-4 p-6" data-reveal style="--reveal-delay: 300ms">
      <h3 class="text-xl text-magenta">Idiomas</h3>
      <dl class="flex flex-col divide-y divide-line">
        {
          languages.map((lang) => (
            <div class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
              <dt class="text-base text-ink">{lang.name}</dt>
              <dd class:list={['level-tag', lang.level === 'Avanzado' && 'level-tag-high']}>{lang.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
