---
import type { SkillCategory } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;

const techSkills = skills.filter((group) => group.category !== 'Idiomas');
const languageGroup = skills.find((group) => group.category === 'Idiomas');

const languages =
  languageGroup?.skills.map((entry) => {
    const match = entry.match(/^(.+?)\s*\((.+)\)$/);
    return {
      name: match?.[1]?.trim() ?? entry,
      level: match?.[2]?.trim() ?? '',
    };
  }) ?? [];
---

<section id="tecnologias" aria-labelledby="tecnologias-titulo" class="relative overflow-x-clip">
<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
  <SectionHeading
    id="tecnologias-titulo"
    kana="技術"
    meaning="tecnología"
    title="Tecnologías e idiomas"
    intro="Herramientas con las que he trabajado, agrupadas por área. El stack principal aparece primero."
  />

  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    <dl data-reveal class="flex flex-col divide-y divide-line overflow-hidden rounded-2xl border-2 border-line bg-surface lg:col-span-2">
      {
        techSkills.map((group) => (
          <div class="grid gap-2 p-6 sm:grid-cols-3 sm:gap-6">
            <dt class="text-sm font-semibold text-yellow">{group.category}</dt>
            <dd class="sm:col-span-2">
              <ul class="flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <li class="rounded-md border border-line px-2 py-1 font-mono text-xs text-ink-muted">{skill}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <div data-reveal class="h-max rounded-2xl border-2 border-canvas bg-lavender p-6 text-canvas pop-shadow">
      <h3 class="text-lg font-semibold">Idiomas</h3>
      <dl class="mt-4 flex flex-col divide-y divide-canvas/30">
        {
          languages.map((lang) => (
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-base font-medium">{lang.name}</dt>
              <dd class="text-sm">{lang.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
</section>
