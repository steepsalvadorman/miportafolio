---
import type { SkillCategory } from '../data/portfolio';
import AeroWindow from './AeroWindow.astro';

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;

const techSkills = skills.filter((group) => group.category !== 'Idiomas');
const languageGroup = skills.find((group) => group.category === 'Idiomas');

const languages =
  languageGroup?.skills.map((entry) => {
    const match = entry.match(/^(.+?)\s*\((.+)\)$/);
    return {
      name: match?.[1]?.trim() ?? entry,
      level: match?.[2]?.trim() ?? '',
    };
  }) ?? [];
---

<AeroWindow id="tecnologias" caption="Tecnologías e idiomas" as="h2" headingId="tecnologias-titulo">
  <div class="grid gap-6 lg:grid-cols-3">
    <dl class="flex flex-col divide-y divide-line lg:col-span-2">
      {
        techSkills.map((group) => (
          <div class="grid gap-2 py-4 first:pt-0 last:pb-0 sm:grid-cols-3 sm:gap-6">
            <dt class="text-sm font-semibold text-atrium">{group.category}</dt>
            <dd class="sm:col-span-2">
              <ul class="flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <li class="border border-line px-2 py-1 text-xs text-ink">{skill}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="h-max border border-line p-4">
      <h3 class="text-lg font-semibold text-ink">Idiomas</h3>
      <dl class="mt-2 flex flex-col divide-y divide-line">
        {
          languages.map((lang) => (
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-base">{lang.name}</dt>
              <dd class="text-sm text-ink-muted">{lang.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</AeroWindow>
