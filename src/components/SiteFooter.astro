---
import { currentYear, personalInfo } from '../data/portfolio';

const links = [
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/certificados', label: 'Certificados' },
  { href: '/#contacto', label: 'Contacto' },
  { href: '#contenido', label: 'Volver arriba' },
];
---

<footer class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6">
  <div class="flex flex-col gap-6 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <p class="font-display text-2xl font-bold text-yellow">{personalInfo.name}</p>
      <p class="text-sm text-ink-muted">{personalInfo.title}. Backend, QA e integración de sistemas.</p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="flex flex-wrap gap-x-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="task-link px-0">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="mt-6 font-mono text-xs text-ink-muted">&copy; {currentYear} {personalInfo.name}</p>
</footer>
