---
const ticks = Array.from({ length: 12 }, (_, index) => index);
---

<div class="flex flex-col gap-2">
  <p class="optic-plate">
    <span>Hora</span>
  </p>
  <svg data-clock-face viewBox="0 0 100 100" class="mx-auto size-32" role="img" aria-label="Reloj analógico">
    <circle cx="50" cy="50" r="46" fill="#07060d" stroke="#3dfff2" stroke-width="2" />
    {
      ticks.map((tick) => (
        <line
          x1="50"
          y1="12"
          x2="50"
          y2={tick % 3 === 0 ? '20' : '16'}
          stroke="#3dfff2"
          stroke-width={tick % 3 === 0 ? '2' : '1'}
          transform={`rotate(${tick * 30} 50 50)`}
        />
      ))
    }
    <g data-hand="hour">
      <line x1="50" y1="52" x2="50" y2="30" stroke="#f4f0ff" stroke-width="3" />
    </g>
    <g data-hand="minute">
      <line x1="50" y1="54" x2="50" y2="20" stroke="#f4f0ff" stroke-width="2" />
    </g>
    <g class="clock-second" data-hand="second">
      <line x1="50" y1="58" x2="50" y2="14" stroke="#ff2bd6" stroke-width="1.25" />
    </g>
    <circle cx="50" cy="50" r="2.5" fill="#f4f227" />
  </svg>
  <p data-clock-text class="optic-readout">--:--</p>
  <p data-clock-date class="optic-date">&nbsp;</p>
</div>
