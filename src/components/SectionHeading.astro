---
interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, index, label, title, intro } = Astro.props;
---

<header data-reveal class="flex max-w-[680px] flex-col gap-4">
  <p class="hud-label">
    <span class="text-magenta">{index}</span>
    <span class="hud-rule" aria-hidden="true"></span>
    {label}
  </p>
  <h2 id={id} class="text-4xl text-ink md:text-5xl">{title}</h2>
  {intro && <p class="text-lg text-ink-muted">{intro}</p>}
</header>
